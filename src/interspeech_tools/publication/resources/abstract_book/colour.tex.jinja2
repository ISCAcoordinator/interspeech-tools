
\BLOCK{ for scope, html_code in default_colors.items() }

%% Default colour information
\definecolor{Default\VAR{scope.capitalize()}Colour}{HTML}{\VAR{html_code}}
\colorlet{Default\VAR{scope.capitalize()}Colour}{Default\VAR{scope.capitalize()}Colour}

\BLOCK{ endfor }

%% FIXME: hardcoded
\colorlet{LinkColour}{black}
\colorlet{FooterBackgroundColour}{DefaultBackgroundColour}
\colorlet{FooterForegroundColour}{DefaultForegroundColour}
\colorlet{RoomColour}{DefaultForegroundColour}
\colorlet{RoomCellColour}{gray!25!white}


%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Colours not defined in the configuration
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\BLOCK{ for cur_type, color_info in known_types.items() }

%% \VAR{cur_type.replace('_', ' ').title().replace(' ', '')} colour information
\BLOCK{ for scope, html_code in color_info.items() }
\definecolor{\VAR{cur_type.replace('_', ' ').title().replace(' ', '')}\VAR{scope.capitalize()}Colour}{HTML}{\VAR{html_code}}
\colorlet{\VAR{cur_type.replace('_', ' ').title().replace(' ', '')}\VAR{scope.capitalize()}Colour}{\VAR{cur_type.replace('_', ' ').title().replace(' ', '')}\VAR{scope.capitalize()}Colour}
\BLOCK{ endfor }

\BLOCK{ endfor }

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Colours not defined in the configuration (so defaulting)
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\BLOCK{ for cur_type in unknown_types }
%% \VAR{cur_type.replace('_', ' ').title().replace(' ', '')} colour information
\BLOCK{ for scope, _ in default_colors.items() }
\colorlet{\VAR{cur_type.replace('_', ' ').title().replace(' ', '')}\VAR{scope.capitalize()}Colour}{Default\VAR{scope.capitalize()}Colour}
\BLOCK{ endfor }
\BLOCK{ endfor }

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% And finally define some styles
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\tcbset{
    default/.style={colframe=DefaultForegroundColour, colback=DefaultBackgroundColour},
    \BLOCK{ for cur_type, _ in known_types.items() }
    \VAR{cur_type}/.style={{colframe=\VAR{cur_type.replace('_', ' ').title().replace(' ', '')}ForegroundColour, colback=\VAR{cur_type.replace('_', ' ').title().replace(' ', '')}BackgroundColour}},
    \BLOCK{ endfor }
    \BLOCK{ for cur_type in unknown_types }
    \VAR{cur_type}/.style={{colframe=\VAR{cur_type.replace('_', ' ').title().replace(' ', '')}ForegroundColour, colback=\VAR{cur_type.replace('_', ' ').title().replace(' ', '')}BackgroundColour}},
    \BLOCK{ endfor }
}
