            {\footnotesize \VAR{author.lastname | latexify}, \VAR{author.firstname | latexify}\dotfill \authorpaperbox{\hyperlink{\VAR{presentation | short_presentation_id}}{\VAR{presentation | short_presentation_id}} \hfill [\pageref*{\VAR{presentation | short_presentation_id}}]}} \newline
        \BLOCK{ else }
            {\footnotesize~\hfill\authorpaperbox{\hyperlink{\VAR{presentation | short_presentation_id}}{\VAR{presentation | short_presentation_id}} \hfill [\pageref*{\VAR{presentation | short_presentation_id}}]}} \newline
        \BLOCK{ endif }
    \BLOCK{ endfor }
\BLOCK{ endfor }
\end{FlushLeft}
\end{multicols*}
